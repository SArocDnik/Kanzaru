# LLM Provider: "gemini" (default) or "ollama"
KANZARU_LLM_PROVIDER=gemini

# Gemini API — get key at https://aistudio.google.com/apikey
KANZARU_GEMINI_API_KEY=
KANZARU_GEMINI_MODEL=gemini-flash-latest
KANZARU_GEMINI_QUALITY_MODEL=gemini-pro-latest
KANZARU_GEMINI_REQUEST_DELAY=4.0
KANZARU_GEMINI_MAX_RETRIES=3

# Ollama (fallback when KANZARU_LLM_PROVIDER=ollama)
KANZARU_OLLAMA_URL=http://localhost:11434
KANZARU_OLLAMA_MODEL=qwen2.5:7b

# App
KANZARU_DB_PATH=data/kanzaru.db
KANZARU_AUDIO_DIR=audio
KANZARU_UPLOAD_DIR=uploads
KANZARU_CORS_ORIGINS=http://localhost:5173
